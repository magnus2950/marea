{
  "type": "footer",
  "name": "Footer group",
  "sections": {
    "text-with-icons": {
      "type": "text-with-icons",
      "blocks": {
        "icon-1": {
          "type": "item",
          "settings": {
            "icon": "picto-delivery-truck",
            "title": "Fri fragt fra 499 kr.",
            "content": "<p>Hurtig levering i Danmark</p>",
            "icon_width": 28,
            "mobile_icon_width": 24
          }
        },
        "icon-2": {
          "type": "item",
          "settings": {
            "icon": "picto-return",
            "title": "30 dages retur",
            "content": "<p>Nem retur og ombytning</p>",
            "icon_width": 28,
            "mobile_icon_width": 24
          }
        },
        "icon-3": {
          "type": "item",
          "settings": {
            "custom_icon": "shopify://shop_images/icon-waterproof.png",
            "title": "Waterproof jewellery",
            "content": "<p>Smykker du kan beholde på</p>",
            "icon_width": 36,
            "mobile_icon_width": 32
          }
        },
        "icon-4": {
          "type": "item",
          "settings": {
            "icon": "picto-customer-support",
            "title": "Kundeservice",
            "content": "<p>hello@marea.dk</p>",
            "icon_width": 28,
            "mobile_icon_width": 24
          }
        }
      },
      "block_order": ["icon-1", "icon-2", "icon-3", "icon-4"],
      "settings": {
        "color_scheme": "scheme-2",
        "separate_section_with_border": false,
        "stack_on_mobile": false,
        "text_alignment": "center"
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "newsletter": {
          "type": "newsletter",
          "settings": {
            "title": "Bliv en del af MAREA",
            "content": "<p>Tilmeld dig og få de første nyheder om launch, nye drops og kampagner.</p>"
          }
        },
        "links-shop": {
          "type": "links",
          "settings": {
            "menu": "footer-shop",
            "show_menu_title": true,
            "menu_title": "Shop"
          }
        },
        "links-service": {
          "type": "links",
          "settings": {
            "menu": "footer-service",
            "show_menu_title": true,
            "menu_title": "Kundeservice"
          }
        },
        "links-about": {
          "type": "links",
          "settings": {
            "menu": "footer-about",
            "show_menu_title": true,
            "menu_title": "Om MAREA"
          }
        },
        "text-contact": {
          "type": "text",
          "settings": {
            "title": "Kontakt",
            "content": "<p>MAREA Jewellery Copenhagen<br>hello@marea.dk</p><p>Følg os på Instagram <a href=\"https://www.instagram.com/mareajewellerycph/\" target=\"_blank\" rel=\"noopener\">@mareajewellerycph</a></p>",
            "enable_follow_on_shop": false
          }
        }
      },
      "block_order": ["newsletter", "links-shop", "links-service", "links-about", "text-contact"],
      "settings": {
        "color_scheme": "scheme-3",
        "separate_section_with_border": false,
        "show_social_media": true,
        "show_payment_icons": true,
        "show_powered_by_shopify": false,
        "show_country_selector": false,
        "show_country_name": false,
        "show_country_flag": false,
        "show_locale_selector": false
      }
