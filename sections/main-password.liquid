{%- comment -%}
  MAREA password / coming-soon page. Layout matches the SS26 launch mockup.
{%- endcomment -%}

<div class="marea-password color-scheme color-scheme--scheme-1">
  {%- comment -%} -- header -- {%- endcomment -%}
  <header class="marea-password__header">
    <div class="marea-password__header-inner">
      <span class="marea-password__header-spacer"></span>
      <h1 class="marea-password__logo">
        {%- if section.settings.logo -%}
          {{- section.settings.logo | image_url: width: 600 | image_tag: widths: '200,300,400,500,600', alt: shop.name, class: 'marea-password__logo-image' -}}
        {%- else -%}
          <span class="h4">{{ shop.name }}</span>
        {%- endif -%}
      </h1>
      <button class="marea-password__lock" type="button" aria-controls="storefront-password-drawer" aria-label="{{ 'password.storefront_access.enter_password' | t }}">
        {%- render 'icon' with 'lock', width: 14 -%}
      </button>
    </div>
  </header>

  {%- comment -%} -- hero -- {%- endcomment -%}
  <section class="marea-password__hero">
    {%- if section.settings.hero_image -%}
      {{- section.settings.hero_image | image_url: width: section.settings.hero_image.width | image_tag: widths: '600,800,1000,1200,1600,2000', class: 'marea-password__hero-image', sizes: '60vw', loading: 'eager' -}}
    {%- endif -%}

    <div class="marea-password__hero-content">
      <h2 class="marea-password__hero-title h1">COMING SOON</h2>
      <p class="marea-password__hero-subtitle h5">Bliv den første til at få besked om åbningen</p>
      <p class="marea-password__hero-text">Tilmeld dig nyhedsbrevet og deltag i konkurrencen om valgfrie smykker til en værdi af 1.000 kr.</p>

      {%- form 'customer', class: 'marea-password__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,coming-soon">
        <input type="hidden" name="contact[accepts_marketing]" value="true">

        {%- if form.posted_successfully? -%}
          <p class="marea-password__form-success">Tak — vi giver dig besked når vi åbner.</p>
        {%- else -%}
          <div class="marea-password__form-row">
            <input type="email" name="contact[email]" placeholder="Din e-mailadresse" required class="marea-password__form-input" aria-label="E-mail">
            <button type="submit" class="marea-password__form-button">Skriv mig op</button>
          </div>
          {%- if form.errors -%}
            <p class="marea-password__form-error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}

        <p class="marea-password__form-fineprint">Ved tilmelding accepterer du at modtage e-mails fra MAREA Jewellery Copenhagen.</p>
      {%- endform -%}
    </div>
  </section>

  {%- comment -%} -- 3-feature trust strip (grid on desktop, marquee on mobile) -- {%- endcomment -%}
  {%- capture features_html -%}
    <div class="marea-password__feature">
      <img src="{{ 'marea-icon-drop-v2.png' | file_url }}" alt="" class="marea-password__feature-icon">
      <span class="marea-password__feature-label">WATERPROOF</span>
    </div>
    <div class="marea-password__feature">
      <img src="{{ 'marea-icon-sun-v2.png' | file_url }}" alt="" class="marea-password__feature-icon">
      <span class="marea-password__feature-label">EVERYDAY</span>
    </div>
    <div class="marea-password__feature">
      <img src="{{ 'marea-icon-wave-v2.png' | file_url }}" alt="" class="marea-password__feature-icon">
      <span class="marea-password__feature-label">SPORT &amp; SEA</span>
    </div>
  {%- endcapture -%}
  <section class="marea-password__features">
    <div class="marea-password__features-track">
      {{ features_html }}
      <div class="marea-password__features-clone" aria-hidden="true">{{ features_html }}</div>
    </div>
  </section>

  {%- comment -%} -- 3 lifestyle images -- {%- endcomment -%}
  <section class="marea-password__gallery">
    <img src="{{ 'marea-product-flatlay.jpg' | file_url }}" alt="" class="marea-password__gallery-image" loading="lazy">
    <img src="{{ 'marea-lifestyle-waterside.jpg' | file_url }}" alt="" class="marea-password__gallery-image" loading="lazy">
    <img src="{{ 'marea-lifestyle-sport.jpg' | file_url }}" alt="" class="marea-password__gallery-image" loading="lazy">
  </section>

  {%- comment -%} -- brand statement -- {%- endcomment -%}
  <section class="marea-password__statement">
    <div class="marea-password__statement-left">
      <h3 class="h2 marea-password__statement-title">Smykker du kan beholde på.</h3>
      <img src="{{ 'marea-wave-divider.png' | file_url }}" alt="" class="marea-password__statement-wave">
    </div>
    <div class="marea-password__statement-right">
      <p>Et nyt smykkeunivers til bad, sport, strand og hverdag — skabt til dig, der vil føle dig velklædt hele dagen.</p>
    </div>
  </section>

  {%- comment -%} -- hidden storefront password drawer -- {%- endcomment -%}
  <x-drawer id="storefront-password-drawer" class="drawer drawer--right" open-from="right" tabindex="-1">
    <button class="drawer__close-button button button--ghost" data-action="close">
      <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
      {%- render 'icon' with 'close' -%}
    </button>
    <div class="drawer__content">
      {%- form 'storefront_password', class: 'form v-stack gap-4' -%}
        <p class="text-center">{{ 'password.storefront_access.instructions' | t }}</p>
        {%- if form.errors -%}
          {%- render 'banner', status: 'error', content: form.errors.messages['form'], text_alignment: 'center' -%}
        {%- endif -%}
        {%- render 'input', type: 'password', name: 'password', label: 'password.storefront_access.password' | t, required: true -%}
        {%- render 'button', type: 'submit', content: 'password.storefront_access.enter_store' | t, stretch: true -%}
      {%- endform -%}
    </div>
  </x-drawer>
</div>

<style>
  .marea-password {
    min-height: 100vh;
    background: rgb(var(--background));
    color: rgb(var(--text-color));
  }
  .marea-password__header {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 5;
    padding: 1rem 1.5rem;
    background: transparent;
  }
  .marea-password__header .marea-password__logo-image {
    filter: brightness(0) invert(1);
  }
  .marea-password__header .marea-password__lock {
    color: #fff;
    opacity: .85;
  }
  .marea-password__header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto;
  }
  .marea-password__logo { margin: 0; justify-self: center; }
  .marea-password__logo-image { max-width: 160px; height: auto; display: block; }
  .marea-password__header-spacer { display: block; }
  .marea-password__lock {
    justify-self: end;
    background: transparent; border: 0; cursor: pointer;
    color: currentColor; padding: .5rem;
    opacity: .5;
  }
  .marea-password__lock:hover { opacity: 1; }

  .marea-password__hero {
    position: relative;
    min-height: 59.5vh;
    display: grid;
  }
  .marea-password__hero-image {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .marea-password__hero-content {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 4rem 2rem;
    align-self: center;
  }
  .marea-password__hero-content > * { max-width: 540px; }
  .marea-password__hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    margin: 0 0 1.5rem;
    text-transform: uppercase;
  }
  .marea-password__hero-subtitle { margin: 0 0 1rem; font-weight: 400; }
  .marea-password__hero-text { margin: 0 0 1.5rem; line-height: 1.55; }
  .marea-password__form { max-width: 540px; }
  .marea-password__form-row {
    display: grid;
    grid-template-columns: 1fr auto;
    background: #fff;
    border: 1px solid rgb(var(--text-color) / .2);
    border-radius: 6px;
    overflow: hidden;
  }
  .marea-password__form-input {
    background: transparent; border: 0; outline: none;
    padding: .9rem 1rem;
    font: inherit; color: currentColor;
  }
  .marea-password__form-button {
    background: rgb(var(--text-color));
    color: rgb(var(--background));
    padding: .9rem 1.5rem;
    border: 0; cursor: pointer;
    font: inherit;
  }
  .marea-password__form-fineprint {
    margin-top: .75rem; font-size: .8rem; opacity: .65; line-height: 1.4;
  }
  .marea-password__form-success {
    padding: .9rem 1rem; background: rgb(var(--text-color) / .06); border-radius: 6px;
  }
  .marea-password__form-error { color: #b5453b; font-size: .85rem; margin-top: .4rem; }

  .marea-password__features {
    padding: 1.5rem 2rem;
    max-width: 1280px;
    margin: 0 auto;
    border-bottom: 1px solid rgb(var(--text-color) / .08);
    overflow: hidden;
  }
  .marea-password__features-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    gap: 1rem;
  }
  .marea-password__features-clone { display: none; }
  .marea-password__feature {
    display: flex; align-items: center; justify-content: center;
    gap: .75rem; position: relative;
  }
  .marea-password__feature + .marea-password__feature::before {
    content: ""; position: absolute;
    inset-block: .25rem; inset-inline-start: 0;
    width: 1px; background: rgb(var(--text-color) / .12);
  }
  .marea-password__feature-icon { width: 42px; height: 42px; object-fit: contain; }
  .marea-password__feature-label { font-size: .78rem; letter-spacing: .08em; font-weight: 500; }

  .marea-password__gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 2rem;
    max-width: 1280px;
    margin: 0 auto;
  }
  .marea-password__gallery-image {
    width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 6px;
  }

  .marea-password__statement {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    padding: 3rem 2rem 5rem;
    max-width: 1280px;
    margin: 0 auto;
    align-items: start;
    border-top: 1px solid rgb(var(--text-color) / .08);
  }
  .marea-password__statement-left { position: relative; }
  .marea-password__statement-title { margin: 0 0 1rem; line-height: 1.05; }
  .marea-password__statement-wave { display: block; width: 60px; height: auto; }
  .marea-password__statement-right { position: relative; padding-inline-start: 3rem; }
  .marea-password__statement-right::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block: .25rem;
    width: 1px;
    background: rgb(var(--text-color) / .2);
  }
  .marea-password__statement-right p { margin: 0; line-height: 1.6; opacity: .85; }

  @media (max-width: 700px) {
    .marea-password__hero { min-height: auto; }
    .marea-password__hero-image { position: relative; aspect-ratio: 4/3; height: auto; }
    .marea-password__hero-content { padding: 2rem 1.5rem; }
    .marea-password__features { padding: 1.25rem 0; }
    .marea-password__features-track {
      display: flex;
      width: max-content;
      gap: 2.5rem;
      animation: marea-marquee 22s linear infinite;
    }
    .marea-password__features-clone { display: flex; gap: 2.5rem; }
    .marea-password__feature { flex: 0 0 auto; padding-inline-start: 1.25rem; }
    .marea-password__feature::before {
      content: ""; position: absolute;
      inset-block: .25rem; inset-inline-start: -1.25rem;
      width: 1px; background: rgb(var(--text-color) / .12);
    }
    .marea-password__feature:first-child::before { display: none; }
    @keyframes marea-marquee {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marea-password__features-track { animation: none; }
    }
    .marea-password__gallery { grid-template-columns: 1fr; }
    .marea-password__statement { grid-template-columns: 1fr; gap: 1.5rem; padding: 2rem 1.5rem 3rem; }
    .marea-password__statement-right { padding-inline-start: 0; }
    .marea-password__statement-right::before { display: none; }
  }
</style>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero background image" }
  ]
}
{% endschema %}
