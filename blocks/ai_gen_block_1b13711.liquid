    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Billede 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Billede"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Titel"
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Beskrivelse"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Smykke showcase"
    }
  ]
}
{% endschema %}
